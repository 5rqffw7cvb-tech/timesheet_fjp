# PostgreSQL (Supabase / Neon / Postgres nội bộ đều được)
DATABASE_URL="postgresql://user:password@host:5432/timesheet?sslmode=require"

# Chuỗi bí mật ký session cookie — BẮT BUỘC đổi khi deploy
# Tạo bằng: openssl rand -base64 48
AUTH_SECRET="doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# Mật khẩu khởi tạo cho tài khoản admin khi chạy seed lần đầu
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"

# Mật khẩu mặc định cấp cho member mới (member bắt buộc đổi ở lần đăng nhập đầu)
DEFAULT_MEMBER_PASSWORD="Fpt@123456"
